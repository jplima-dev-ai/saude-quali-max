{
  "name": "saude-qualimax",
  "version": "3.9.0",
  "private": true,
  "description": "Plataforma web acessível e white-label para e-commerce, com NVDA, WCAG, PWA, Playwright, Axe e CI/CD.",
  "scripts": {
    "dev": "python tools/serve.py",
    "setup:python": "python -m pip install -r requirements.txt",
    "build": "python tools/build-pages.py",
    "test": "python tools/run-tests.py --rounds 1",
    "test:release": "python tools/run-tests.py --rounds 3",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "screenshots": "playwright test --config playwright.screenshots.config.js",
    "metrics": "python tools/audit-metrics-v380.py",
    "metrics:write": "python tools/audit-metrics-v380.py --write",
    "format": "prettier --write README.md docs .github tests/e2e tests/visual playwright.config.js playwright.screenshots.config.js package.json",
    "format:check": "prettier --check README.md docs .github tests/e2e tests/visual playwright.config.js playwright.screenshots.config.js package.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "accessibility",
    "web-accessibility",
    "wcag",
    "nvda",
    "screen-reader",
    "inclusive-design",
    "frontend",
    "javascript",
    "html",
    "css",
    "pwa",
    "playwright",
    "axe-core",
    "e2e-testing",
    "github-actions",
    "ci-cd",
    "white-label",
    "ecommerce",
    "responsive-design"
  ],
  "homepage": "https://jplima-dev-ai.github.io/saude-quali-max/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jplima-dev-ai/saude-quali-max.git"
  },
  "bugs": {
    "url": "https://github.com/jplima-dev-ai/saude-quali-max/issues"
  },
  "author": "João Paulo Lima",
  "license": "SEE LICENSE IN LICENSE.md"
}
